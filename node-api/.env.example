# ==============================================================================
# Node.js API Service Configuration
# ==============================================================================
PORT=3000
NODE_ENV=development

# Database Connection (Shared PostgreSQL Database)
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/candidate_verification

# Internal Go Auth Service Connection
GO_AUTH_INTERNAL_URL=http://localhost:8080
INTERNAL_SERVICE_SECRET=SET_LOCALLY

# CORS Whitelist (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

RESUME_STORAGE_PATH=D:/CandidateVerificationSystem/private-storage/resumes
MAX_RESUME_SIZE_MB=5
